# Load a local copy with: set -a; . config/site.local.env; set +a
# The workspace defaults to the command's starting working directory.
# Set an absolute workspace to run commands from other directories.
# G1D_VR_WORKSPACE=/path/to/teleop-workspace
# All paths below are relative to the resolved workspace.
G1D_VR_STATE_ROOT=state
G1D_VR_INPUT_ROOT=state/input
G1D_VR_RECORD_ROOT=records
G1D_VR_XR_ROOT=deps/xr_teleoperate
G1D_VR_CLIENT_SOURCE=deps/ial_g1d/src
# This must be the same model used by IK under G1D_VR_XR_ROOT/assets.
G1D_VR_URDF=deps/xr_teleoperate/assets/g1/g1_body29_hand14.urdf
G1D_VR_CERT_FILE=certs/cert.pem
G1D_VR_KEY_FILE=certs/key.pem
G1D_VR_DDS_INTERFACE=eth0
G1D_VR_ROBOT_HOST=127.0.0.1
# Optional interpreter overrides. Omit to reuse the current interpreter.
# The control interpreter needs OpenCV for final video trimming too.
# G1D_VR_PYTHON=.venv/bin/python
# G1D_VR_CAMERA_PYTHON=.venv/bin/python
